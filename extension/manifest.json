{
  "manifest_version": 3,
  "name": "Budgétable – courses en drive",
  "short_name": "Budgétable",
  "version": "1.0.0",
  "description": "Votre liste Budgétable sur le site de votre drive : repérez les produits les moins chers affichés et ajoutez-les d’un clic.",
  "homepage_url": "https://budgetable.onrender.com/extension.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Budgétable",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.carrefour.fr/*",
        "https://www.auchan.fr/*",
        "https://www.e.leclerc/*",
        "https://*.leclercdrive.fr/*",
        "https://www.intermarche.com/*",
        "https://www.coursesu.com/*",
        "https://www.chronodrive.com/*"
      ],
      "js": [
        "drives.js",
        "lecture.js",
        "stockage.js",
        "panneau.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://budgetable.onrender.com/*"
      ],
      "js": [
        "stockage.js",
        "pont.js"
      ],
      "run_at": "document_start"
    }
  ]
}
